{
  "name": "nuzlocke-bench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "test": "npm run typecheck && npm run lint && vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.test.json && tsc -p tsconfig.mjs.json",
    "lint": "eslint . --max-warnings 0",
    "test:watch": "vitest",
    "smoke": "node scripts/mcp-smoke.mjs",
    "smoke:headless": "npm run build && node scripts/mcp-smoke.mjs --headless",
    "bench": "node scripts/bench-run.mjs",
    "bench:report": "node scripts/bench-report.mjs",
    "bench:summary": "node scripts/bench-summary.mjs",
    "bench:dashboard": "node scripts/bench-report.mjs --dashboard runs/dashboard.html",
    "bench:results": "node scripts/bench-results.mjs",
    "bench:friction": "node scripts/bench-friction.mjs",
    "verify": "node scripts/verify-run.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "buffer": "^6.0.3",
    "ws": "^8.22.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.8"
    }
  }
}
